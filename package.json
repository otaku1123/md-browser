{
  "name": "md-browser",
  "version": "1.7.0",
  "description": "",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:ext": "tsc --noEmit && vite build --config vite.extension.config.ts",
    "pack:ext": "npm run build:ext && node scripts/pack-extension.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run build:ext && playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "@plantuml/core": "^1.2026.9",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.10",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-emoji": "^3.0.1",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
